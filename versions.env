# Input image pins for the assembled cloud image.
# Bump these (then rebuild) to pick up upstream releases. Never point both
# at :latest in production — pin digests or version tags so a rebuild is
# reproducible. The CI build job sources this file into docker build-args.
AGENT_IMAGE=ghcr.io/johnsonbuilds/hermes-agent:latest
WEBUI_IMAGE=ghcr.io/nesquena/hermes-webui:latest
